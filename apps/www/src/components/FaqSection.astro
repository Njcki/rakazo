---
import type { FaqItem } from "../guide";

type Props = {
  items: readonly FaqItem[];
};

const { items } = Astro.props;
---

<section aria-labelledby="faq-heading">
  <h2 id="faq-heading">FAQ</h2>
  {
    items.map((item) => (
      <div>
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))
  }
</section>
