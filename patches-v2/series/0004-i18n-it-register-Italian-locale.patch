From d65237c1e505f6eb556b8fbd59cdf3ca694ab509 Mon Sep 17 00:00:00 2001
From: Rakazo patches <bot@local>
Date: Wed, 14 Oct 2026 04:45:50 +0200
Subject: [PATCH 04/11] i18n-it: register Italian locale

---
 apps/web/lingui.config.ts     | 2 +-
 apps/web/src/lib/i18n.ts      | 1 +
 apps/web/src/lib/ui-locale.ts | 5 ++++-
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/apps/web/lingui.config.ts b/apps/web/lingui.config.ts
index 3341df2e..42937522 100644
--- a/apps/web/lingui.config.ts
+++ b/apps/web/lingui.config.ts
@@ -3,7 +3,7 @@ import { formatter } from "@lingui/format-po";
 
 export default defineConfig({
   sourceLocale: "en",
-  locales: ["en", "de", "ko", "tr", "hi", "pt-BR", "zh-CN", "es", "ru", "fr"],
+  locales: ["en", "de", "ko", "tr", "hi", "pt-BR", "zh-CN", "es", "ru", "fr", "it"],
   catalogs: [
     {
       path: "<rootDir>/src/locales/{locale}/messages",
diff --git a/apps/web/src/lib/i18n.ts b/apps/web/src/lib/i18n.ts
index 11690f50..e35c2b5b 100644
--- a/apps/web/src/lib/i18n.ts
+++ b/apps/web/src/lib/i18n.ts
@@ -19,6 +19,7 @@ const defaultCatalogLoaders: Record<UiLocale, CatalogLoader> = {
   es: () => import("../locales/es/messages.po") as Promise<CatalogModule>,
   ru: () => import("../locales/ru/messages.po") as Promise<CatalogModule>,
   fr: () => import("../locales/fr/messages.po") as Promise<CatalogModule>,
+  it: () => import("../locales/it/messages.po") as Promise<CatalogModule>,
 };
 
 let catalogLoaders: Record<UiLocale, CatalogLoader> = defaultCatalogLoaders;
diff --git a/apps/web/src/lib/ui-locale.ts b/apps/web/src/lib/ui-locale.ts
index 5eed5d8b..26df5dda 100644
--- a/apps/web/src/lib/ui-locale.ts
+++ b/apps/web/src/lib/ui-locale.ts
@@ -9,6 +9,7 @@ export const UI_LOCALES = [
   "es",
   "ru",
   "fr",
+  "it",
 ] as const;
 
 export type UiLocale = (typeof UI_LOCALES)[number];
@@ -26,6 +27,7 @@ export const UI_LOCALE_LABELS: Record<UiLocale, string> = {
   es: "Español",
   ru: "Русский",
   fr: "Français",
+  it: "Italiano",
 };
 
 /** Return whether a value is one of the supported web UI locales. */
@@ -40,7 +42,8 @@ export function isUiLocale(value: string | null | undefined): value is UiLocale
     value === "zh-CN" ||
     value === "es" ||
     value === "ru" ||
-    value === "fr"
+    value === "fr" ||
+    value === "it"
   );
 }
 
-- 
