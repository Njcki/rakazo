From 0f9769f7ac6a1ab4726b8965418677f2b0aeed63 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Niccol=C3=B2?= <Njcki@users.noreply.github.com>
Date: Thu, 22 Oct 2026 04:00:26 +0200
Subject: [PATCH] fix(web): add missing Italian translations for Statistics
 feature
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

IT: La funzione "Statistiche" (patch 0032) mostrava gli ID dei messaggi i18n invece delle traduzioni italiane, perché le nuove stringhe mancavano nel catalogo `apps/web/src/locales/it/messages.po`. Aggiunte le traduzioni per: "Statistics" → "Statistiche", "Web searches answered by each service." → "Ricerche web risposte da ciascun servizio.", "No searches recorded yet." → "Nessuna ricerca registrata.", "Could not load statistics" → "Impossibile caricare le statistiche", "Search statistics reset." → "Statistiche delle ricerche azzerate.", "Could not reset the statistics" → "Impossibile azzerare le statistiche".

EN: The "Statistics" feature (patch 0032) showed i18n message IDs instead of Italian translations because the new strings were missing from the `apps/web/src/locales/it/messages.po` catalog. Added translations for: "Statistics" → "Statistiche", "Web searches answered by each service." → "Ricerche web risposte da ciascun servizio.", "No searches recorded yet." → "Nessuna ricerca registrata.", "Could not load statistics" → "Impossibile caricare le statistiche", "Search statistics reset." → "Statistiche delle ricerche azzerate.", "Could not reset the statistics" → "Impossibile azzerare le statistiche".
---
 apps/web/src/locales/it/messages.po | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/apps/web/src/locales/it/messages.po b/apps/web/src/locales/it/messages.po
index a5f496ba..e9829c32 100644
--- a/apps/web/src/locales/it/messages.po
+++ b/apps/web/src/locales/it/messages.po
@@ -4815,3 +4815,27 @@ msgstr "Completato"
 #: src/pages/PlanSection.tsx
 msgid "No plan yet. The bot creates one for multi-step work; completed plans stay here until replaced."
 msgstr "Nessun piano ancora. Il bot ne crea uno per i lavori a più passi; i piani completati restano qui finché non vengono sostituiti."
+
+#: src/pages/AccountSettingsOverlay.tsx
+msgid "Could not load statistics"
+msgstr "Impossibile caricare le statistiche"
+
+#: src/pages/AccountSettingsOverlay.tsx
+msgid "Could not reset the statistics"
+msgstr "Impossibile azzerare le statistiche"
+
+#: src/pages/AccountSettingsOverlay.tsx
+msgid "No searches recorded yet."
+msgstr "Nessuna ricerca registrata."
+
+#: src/pages/AccountSettingsOverlay.tsx
+msgid "Search statistics reset."
+msgstr "Statistiche delle ricerche azzerate."
+
+#: src/pages/SettingsOverlay.tsx
+msgid "Statistics"
+msgstr "Statistiche"
+
+#: src/pages/AccountSettingsOverlay.tsx
+msgid "Web searches answered by each service."
+msgstr "Ricerche web risposte da ciascun servizio."
-- 
