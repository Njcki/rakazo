+          onClose();
+        }}
+      >
+        ×
+      </button>
+      <img
+        src={src}
+        alt={alt}
+        draggable={false}
+        referrerPolicy="no-referrer"
+        style={{ transform: `translate(${pan.x}px, ${pan.y}px) scale(${scale})` }}
