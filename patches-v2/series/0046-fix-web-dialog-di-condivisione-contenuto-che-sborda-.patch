From e52678a2c1eaa1b80c534d0d024455323002ea8a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Niccol=C3=B2?= <Njcki@users.noreply.github.com>
Date: Fri, 23 Oct 2026 17:50:37 +0200
Subject: [PATCH] fix(web): dialog di condivisione, contenuto che sborda dal
 riquadro
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

IT: Il contenuto del dialogo di condivisione sbordava dal riquadro bianco
a destra. La larghezza massima di 560px non veniva applicata a viewport
>= 640px, perché la classe di base sm:max-w-sm (384px) vinceva a cascata,
e la colonna della griglia CSS del Popup poteva superare la larghezza del
contenitore. Si applica sm:max-w-[560px] al contenuto del dialogo e min-w-0
agli elementi della griglia, così il contenuto resta dentro il riquadro.

EN: The share dialog content overflowed the white box to the right. The
560px max-width was not applied at viewports >= 640px because the base
sm:max-w-sm class (384px) won the cascade, and the Popup CSS grid column
could exceed the container width. Apply sm:max-w-[560px] to the dialog
content and min-w-0 to the grid items so the content stays inside the box.
---
 .../src/pages/shell/share-thread-dialog.tsx    | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/apps/web/src/pages/shell/share-thread-dialog.tsx b/apps/web/src/pages/shell/share-thread-dialog.tsx
index e48ad719..83894786 100644
--- a/apps/web/src/pages/shell/share-thread-dialog.tsx
+++ b/apps/web/src/pages/shell/share-thread-dialog.tsx
@@ -168,8 +168,8 @@ export function ShareThreadDialog({
         if (!open && !busy) onClose();
       }}
     >
-      <DialogContent className="max-w-[560px]">
-        <DialogHeader>
+      <DialogContent className="sm:max-w-[560px]">
+        <DialogHeader className="min-w-0">
           <DialogTitle className="flex items-center gap-2.5">
             <Share2 size={17} strokeWidth={1.8} className="text-muted-foreground" aria-hidden="true" />
             <Trans>Share conversation</Trans>
@@ -191,7 +191,7 @@ export function ShareThreadDialog({
           </div>
         ) : (
           <>
-            <div className="flex items-center justify-between px-1">
+            <div className="flex min-w-0 items-center justify-between px-1">
               <Label className="text-[13px] text-muted-foreground">
                 <Trans>{selected.size} of {selectable.length} messages</Trans>
               </Label>
@@ -205,7 +205,7 @@ export function ShareThreadDialog({
               </div>
             </div>
 
-            <ScrollArea className="max-h-[280px] rounded-lg border border-input">
+            <ScrollArea className="max-h-[280px] min-w-0 rounded-lg border border-input">
               <ul className="divide-y divide-input">
                 {selectable.map((message) => {
                   const checked = selected.has(message.id);
@@ -241,8 +241,8 @@ export function ShareThreadDialog({
               </ul>
             </ScrollArea>
 
-            <div className="grid gap-3">
-              <div className="grid gap-1.5">
+            <div className="grid min-w-0 gap-3">
+              <div className="grid min-w-0 gap-1.5">
                 <Label htmlFor="share-title" className="text-[13px] text-muted-foreground">
                   <Trans>Title (optional)</Trans>
                 </Label>
@@ -254,7 +254,7 @@ export function ShareThreadDialog({
                   placeholder={botName}
                 />
               </div>
-              <div className="grid gap-1.5">
+              <div className="grid min-w-0 gap-1.5">
                 <Label className="text-[13px] text-muted-foreground">
                   <Trans>Link expires</Trans>
                 </Label>
@@ -312,7 +312,7 @@ export function ShareThreadDialog({
 
         <Separator />
 
-        <div className="grid gap-1.5">
+        <div className="grid min-w-0 gap-1.5">
           <Label className="text-[13px] font-medium text-muted-foreground">
             <Trans>Active shares</Trans>
           </Label>
@@ -367,7 +367,7 @@ export function ShareThreadDialog({
           )}
         </div>
 
-        <DialogFooter>
+        <DialogFooter className="min-w-0">
           <Button type="button" variant="outline" onClick={onClose}>
             <Trans>Close</Trans>
           </Button>
-- 
