+      ...segments.slice(0, -1),
+      { kind: "text", text: ensureSentenceSpacing(last.text + text) },
+    ];
   }
-  return [...segments, { kind: "text", text }];
+  return [...segments, { kind: "text", text: ensureSentenceSpacing(text) }];
 }
 
