+    /**
+     * Rakazo: while the app holds the device in communication mode (a hands-free call), record
+     * through the voice-communication path so the platform's echo canceller removes the bot's
+     * own voice coming out of the speaker, and the caller can still talk over it.
+     */
+    private fun inCommunicationMode(): Boolean {
+        val audioManager = context.getSystemService(Context.AUDIO_SERVICE) as? android.media.AudioManager
+        return audioManager?.mode == android.media.AudioManager.MODE_IN_COMMUNICATION
+    }
