+    private fun createRecorder(): AudioRecord {
+        val communication = inCommunicationMode()
+        val record =
+            AudioRecord(
+                if (communication) MediaRecorder.AudioSource.VOICE_COMMUNICATION else MediaRecorder.AudioSource.VOICE_RECOGNITION,
+                sampleRateInHz,
+                channelConfig,
+                AudioFormat.ENCODING_PCM_16BIT,
+                bufferSizeInBytes,
+            )
+        if (communication && record.state != AudioRecord.STATE_INITIALIZED) {
+            // A device without a voice-communication input: fall back to the plain one.
+            record.release()
+            return AudioRecord(
+                MediaRecorder.AudioSource.VOICE_RECOGNITION,
+                sampleRateInHz,
+                channelConfig,
+                AudioFormat.ENCODING_PCM_16BIT,
+                bufferSizeInBytes,
+            )
+        }
+        if (communication) {
+            try {
+                if (android.media.audiofx.AcousticEchoCanceler.isAvailable()) {
+                    echoCanceler = android.media.audiofx.AcousticEchoCanceler.create(record.audioSessionId)?.apply { enabled = true }
+                }
+                if (android.media.audiofx.NoiseSuppressor.isAvailable()) {
+                    noiseSuppressor = android.media.audiofx.NoiseSuppressor.create(record.audioSessionId)?.apply { enabled = true }
+                }
+            } catch (e: Exception) {
+                Log.w(TAG, "Echo cancellation unavailable", e)
+            }
+        }
+        return record
+    }
+
+    private fun releaseEffects() {
+        try {
+            echoCanceler?.release()
+            noiseSuppressor?.release()
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to release audio effects", e)
+        }
+        echoCanceler = null
+        noiseSuppressor = null
+    }
 
